# --- Dependencies / environments (never tracked) ---
# (venv/ and env/ are anchored to the root so racer/env/ and configs/env/ stay tracked)
.venv/
/venv/
/env/
*.whl
pip-wheel-metadata/

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Training / output artifacts (large, reproducible) ---
# (git only treats "#" as a comment at the start of a line, so keep comments on their own lines)
# TensorBoard logs
runs/
# raw rendered frames
outputs/frames/
# smoke-test runs (train.py --scratch)
outputs/scratch/
# overnight queue logs and state (scripts/queue_overnight.py)
outputs/queue_logs/
*.tmp

# --- Original asset downloads (large, kept locally for re-cutting; see assets/LICENSES.md) ---
assets/_source/

# Trained models stay LOCAL (owner decision 2026-10-10): too big for git.
# Back them up by copying the folder (current backup: C:\Users\Jack\ML_Sem5_models_backup\).
/models/*
!/models/.gitkeep
# registry/ IS tracked (small CSVs); registry.xlsx is regenerated from them (D11).
registry/registry.xlsx
registry/*.csv.tmp

# --- Editors / OS ---
.vscode/*
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
