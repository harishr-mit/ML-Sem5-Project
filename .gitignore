# --- Dependencies / environments (never tracked) ---
# (venv/ and env/ are anchored to the root so racer/env/ and configs/env/ stay tracked)
.venv/
/venv/
/env/
*.whl
pip-wheel-metadata/

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Training / output artifacts (large, reproducible) ---
# (git only treats "#" as a comment at the start of a line, so keep comments on their own lines)
# TensorBoard logs
runs/
# raw rendered frames
outputs/frames/
*.tmp

# --- Original asset downloads (large, kept locally for re-cutting; see assets/LICENSES.md) ---
assets/_source/

# models/ and registry/ ARE tracked (the demo depends on them).
# If the models folder gets too big, move models/**/checkpoints to Git LFS or ignore them here.

# --- Editors / OS ---
.vscode/*
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
